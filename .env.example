# Current hosting / database
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your_publishable_key

# Payment stays disabled until QIIB provides merchant credentials.
PAYMENT_PROVIDER=QIIB
QIIB_MERCHANT_ID=
QIIB_API_BASE_URL=
QIIB_API_KEY=
QIIB_WEBHOOK_SECRET=

# Email. Use QHost SMTP later without changing application logic.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=Nutripacks <orders@yourdomain.qa>
