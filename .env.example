# Current hosting / database
# Required before production. Do not rely on repository fallback values in production.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your_publishable_key

# Current environment
APP_MODE=testing
PAYMENT_REQUIRED=false

# Email. Use QHost SMTP later without changing application logic.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=Nutripacks <orders@yourdomain.qa>
