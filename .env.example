# Preferred production database: direct Neon PostgreSQL connection.
# The Vercel Neon integration supplies DATABASE_URL and POSTGRES_URL automatically.
DATABASE_URL=
POSTGRES_URL=

# Optional Neon Data API fallback. Direct PostgreSQL is preferred.
NEON_DATA_API_URL=
NEON_DATA_API_TOKEN=

# Current Supabase fallback. Keep these during migration and remove them only after Neon is verified.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your_publishable_key

# Current environment
APP_MODE=testing
PAYMENT_REQUIRED=false

# Email. Use QHost SMTP later without changing application logic.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=Nutripacks <orders@yourdomain.qa>
