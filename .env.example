# Preferred production database: Neon PostgreSQL Data API
# When NEON_DATA_API_URL is set the backend uses Neon. Leave it unset to keep the current Supabase fallback.
NEON_DATA_API_URL=
# Optional. Leave blank only when the Neon Data API is explicitly configured for unauthenticated access.
NEON_DATA_API_TOKEN=

# Current Supabase fallback. Keep these during migration and remove them only after Neon is verified.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your_publishable_key

# Current environment
APP_MODE=testing
PAYMENT_REQUIRED=false

# Email. Use QHost SMTP later without changing application logic.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=Nutripacks <orders@yourdomain.qa>
